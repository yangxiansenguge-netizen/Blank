<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.blank.app.mapper.UserMapper">

    <resultMap id="userMap" type="com.blank.app.entity.User">
        <id column="id" property="id"/>
        <result column="uid" property="uid"/>
        <result column="username" property="username"/>
        <result column="email" property="email"/>
        <result column="identity" property="identity"/>
        <result column="password_hash" property="passwordHash"/>
        <result column="avatar" property="avatar"/>
        <result column="vip_level" property="vipLevel"/>
        <result column="vip_plan_key" property="vipPlanKey"/>
        <result column="vip_expires_at" property="vipExpiresAt"/>
        <result column="coins" property="coins"/>
        <result column="gender" property="gender"/>
        <result column="birthday" property="birthday"/>
        <result column="location" property="location"/>
        <result column="profile_visibility" property="profileVisibility"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <sql id="baseColumns">
        id,uid,username,email,identity,password_hash,avatar,vip_level,vip_plan_key,vip_expires_at,
        coins,gender,birthday,location,profile_visibility,created_at,updated_at
    </sql>

    <select id="selectById" resultMap="userMap">
        SELECT <include refid="baseColumns"/> FROM users WHERE id = #{id}
    </select>

    <select id="selectByEmail" resultMap="userMap">
        SELECT <include refid="baseColumns"/> FROM users WHERE email = #{email}
    </select>

    <select id="selectByUid" resultMap="userMap">
        SELECT <include refid="baseColumns"/> FROM users WHERE uid = #{uid}
    </select>

    <select id="countByEmail" resultType="long">
        SELECT COUNT(*) FROM users WHERE email = #{email}
    </select>

    <select id="countByUsername" resultType="long">
        SELECT COUNT(*) FROM users WHERE username = #{username}
    </select>

    <select id="countByUid" resultType="long">
        SELECT COUNT(*) FROM users WHERE uid = #{uid}
    </select>

    <select id="countByUsernameExcludeSelf" resultType="long">
        SELECT COUNT(*) FROM users WHERE username = #{username} AND id != #{excludeId}
    </select>

    <select id="countByIdentity" resultType="long">
        SELECT COUNT(*) FROM users WHERE identity = #{identity}
    </select>

    <select id="countAll" resultType="long">
        SELECT COUNT(*) FROM users
    </select>

    <select id="searchByKeyword" resultMap="userMap">
        SELECT <include refid="baseColumns"/> FROM users
        WHERE (uid LIKE concat('%',#{keyword},'%') OR username LIKE concat('%',#{keyword},'%'))
        AND id != #{excludeId} LIMIT 20
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO users (uid, username, email, identity, password_hash, avatar, vip_level, coins, gender, profile_visibility)
        VALUES (#{uid},#{username},#{email},#{identity},#{passwordHash},#{avatar},#{vipLevel},#{coins},#{gender},#{profileVisibility})
    </insert>

    <update id="updateById">
        UPDATE users
        <set>
            <if test="username != null">username = #{username},</if>
            <if test="email != null">email = #{email},</if>
            <if test="avatar != null">avatar = #{avatar},</if>
            <if test="vipLevel != null">vip_level = #{vipLevel},</if>
            <if test="vipPlanKey != null">vip_plan_key = #{vipPlanKey},</if>
            <if test="vipExpiresAt != null">vip_expires_at = #{vipExpiresAt},</if>
            <if test="coins != null">coins = #{coins},</if>
            <if test="gender != null">gender = #{gender},</if>
            <if test="birthday != null">birthday = #{birthday},</if>
            <if test="location != null">location = #{location},</if>
            <if test="profileVisibility != null">profile_visibility = #{profileVisibility},</if>
            <if test="passwordHash != null">password_hash = #{passwordHash},</if>
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM users WHERE id = #{id}
    </delete>
</mapper>
