<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.blank.app.mapper.UserStampMapper">

    <resultMap id="userStampMap" type="com.blank.app.entity.UserStamp">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="stamp_id" property="stampId"/>
        <result column="quantity" property="quantity"/>
        <result column="purchased_at" property="purchasedAt"/>
    </resultMap>

    <select id="selectByUserAndStamp" resultMap="userStampMap">
        SELECT * FROM user_stamps WHERE user_id = #{userId} AND stamp_id = #{stampId}
    </select>

    <select id="selectByUserId" resultMap="userStampMap">
        SELECT * FROM user_stamps WHERE user_id = #{userId} AND quantity &gt; 0
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO user_stamps (user_id, stamp_id, quantity, purchased_at)
        VALUES (#{userId},#{stampId},#{quantity},#{purchasedAt})
    </insert>

    <update id="updateById">
        UPDATE user_stamps SET quantity = #{quantity} WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM user_stamps WHERE id = #{id}
    </delete>

    <delete id="deleteByUserId">
        DELETE FROM user_stamps WHERE user_id = #{userId}
    </delete>
</mapper>
