<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.blank.app.mapper.StampSeriesMapper">
    <resultMap id="seriesMap" type="com.blank.app.entity.StampSeries">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="folder_name" property="folderName"/>
        <result column="description" property="description"/>
        <result column="sort_order" property="sortOrder"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>
    <select id="selectAll" resultMap="seriesMap">
        SELECT * FROM stamp_series ORDER BY sort_order ASC, id ASC
    </select>
    <select id="selectById" resultMap="seriesMap">
        SELECT * FROM stamp_series WHERE id = #{id}
    </select>
    <select id="selectByName" resultMap="seriesMap">
        SELECT * FROM stamp_series WHERE name = #{name}
    </select>
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO stamp_series (name, folder_name, description, sort_order) VALUES (#{name},#{folderName},#{description},#{sortOrder})
    </insert>
    <update id="updateById">
        UPDATE stamp_series
        <set>
            <if test="name != null">name = #{name},</if>
            <if test="folderName != null">folder_name = #{folderName},</if>
            <if test="description != null">description = #{description},</if>
            <if test="sortOrder != null">sort_order = #{sortOrder},</if>
        </set>
        WHERE id = #{id}
    </update>
    <delete id="deleteById">
        DELETE FROM stamp_series WHERE id = #{id}
    </delete>
</mapper>
