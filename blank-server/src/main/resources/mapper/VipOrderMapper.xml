<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.blank.app.mapper.VipOrderMapper">
    <resultMap id="vipOrderMap" type="com.blank.app.entity.VipOrder">
        <id column="id" property="id"/>
        <result column="order_no" property="orderNo"/>
        <result column="user_id" property="userId"/>
        <result column="plan_key" property="planKey"/>
        <result column="plan_title" property="planTitle"/>
        <result column="amount_cents" property="amountCents"/>
        <result column="payment_type" property="paymentType"/>
        <result column="status" property="status"/>
        <result column="zpay_trade_no" property="zpayTradeNo"/>
        <result column="pay_url" property="payUrl"/>
        <result column="request_ip" property="requestIp"/>
        <result column="device" property="device"/>
        <result column="notify_raw" property="notifyRaw"/>
        <result column="paid_at" property="paidAt"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>
    <select id="selectByOrderNo" resultMap="vipOrderMap">
        SELECT * FROM vip_orders WHERE order_no = #{orderNo}
    </select>
    <select id="selectLatestByUserId" resultMap="vipOrderMap">
        SELECT * FROM vip_orders WHERE user_id = #{userId} ORDER BY created_at DESC LIMIT 1
    </select>
    <select id="selectByOrderNoAndUser" resultMap="vipOrderMap">
        SELECT * FROM vip_orders WHERE order_no = #{orderNo} AND user_id = #{userId}
    </select>
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO vip_orders (order_no, user_id, plan_key, plan_title, amount_cents, payment_type, status, pay_url, request_ip, device)
        VALUES (#{orderNo},#{userId},#{planKey},#{planTitle},#{amountCents},#{paymentType},#{status},#{payUrl},#{requestIp},#{device})
    </insert>
    <update id="updateById">
        UPDATE vip_orders
        <set>
            <if test="status != null">status = #{status},</if>
            <if test="zpayTradeNo != null">zpay_trade_no = #{zpayTradeNo},</if>
            <if test="notifyRaw != null">notify_raw = #{notifyRaw},</if>
            <if test="paidAt != null">paid_at = #{paidAt},</if>
        </set>
        WHERE id = #{id}
    </update>
</mapper>
