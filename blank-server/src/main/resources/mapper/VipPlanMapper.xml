<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.blank.app.mapper.VipPlanMapper">
    <select id="selectActiveAll" resultType="com.blank.app.entity.VipPlan">
        SELECT * FROM vip_plans WHERE is_active = 1 ORDER BY sort_order ASC
    </select>
    <select id="selectByPlanKey" resultType="com.blank.app.entity.VipPlan">
        SELECT * FROM vip_plans WHERE plan_key = #{planKey} AND is_active = 1
    </select>
</mapper>
