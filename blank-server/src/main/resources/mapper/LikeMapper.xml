<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.blank.app.mapper.LikeMapper">

    <select id="selectByUserAndPostcard" resultType="com.blank.app.entity.Like">
        SELECT * FROM likes WHERE user_id = #{userId} AND postcard_id = #{postcardId}
    </select>

    <select id="countByPostcardId" resultType="long">
        SELECT COUNT(*) FROM likes WHERE postcard_id = #{postcardId}
    </select>

    <select id="selectUserLikeIds" resultType="integer">
        SELECT postcard_id FROM likes WHERE user_id = #{userId}
    </select>

    <select id="selectFavoritesPage" resultType="integer">
        SELECT postcard_id FROM likes WHERE user_id = #{userId} ORDER BY created_at DESC
    </select>

    <select id="countByUserId" resultType="long">
        SELECT COUNT(*) FROM likes WHERE user_id = #{userId}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO likes (user_id, postcard_id) VALUES (#{userId},#{postcardId})
    </insert>

    <delete id="deleteById">
        DELETE FROM likes WHERE id = #{id}
    </delete>

    <delete id="deleteByUserId">
        DELETE FROM likes WHERE user_id = #{userId}
    </delete>

    <delete id="deleteByPostcardId">
        DELETE FROM likes WHERE postcard_id = #{postcardId}
    </delete>
</mapper>
